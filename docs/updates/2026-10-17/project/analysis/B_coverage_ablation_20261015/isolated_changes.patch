+def coverage_view(problem, pending_tasks, now, end):
+    """Counts and exact public resource rows. No rankings or assignments."""
+    horizon = min(now + 300, end)
+    ready, future, queues = Counter(), Counter(), Counter(t['machine'] for t in pending_tasks)
+    families = {}
+    for m in problem['machines']:
