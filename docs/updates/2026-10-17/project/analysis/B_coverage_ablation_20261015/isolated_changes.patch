+        f = families[m['family']]; f['machines'] += 1; f['busy'] += m['currently_busy']; f['nominal_available_within_window'] += m['available_at'] <= horizon; f['pending_tasks'] += queues[m['machine']]
+    for op in problem['operations']:
+        counter = future if op['conditional'] else ready
+        counter.update(op['eligible_machines'])
+        if op['family'] in families: families[op['family']]['conditional_operations' if op['conditional'] else 'ready_operations'] += 1
+    rows = [dict(m, pending_task_count=queues[m['machine']], ready_eligible_operation_count=ready[m['machine']], conditional_eligible_operation_count=future[m['machine']]) for m in problem['machines'] if m['available_at'] <= horizon or queues[m['machine']]]
